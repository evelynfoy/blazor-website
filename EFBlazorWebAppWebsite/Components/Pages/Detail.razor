@page "/detail/{Id:int}"

@rendermode InteractiveServer
@inject HttpClient httpClient
@inject NavigationManager navigationManager

<div class="container border p-3 mt-4">
    <div class="row pb-2">
        <div class="col">
            <h2 class="text-primary pl-3">Project Details</h2>
            <hr />
        </div>
    </div>
    <div class="row pb-3">
        <div class="col">
            <label class="h5">Name</label>
            <InputText class="displaySize" @bind-Value="currentProject!.Name" disabled/>
        </div>
    </div>
    <div class="row pb-3">
        <div class="col">
            <label class="h5">Type</label>
            <InputText class="displaySize" @bind-Value="currentProject!.Type" disabled />
        </div>
    </div>
    <div class="row pb-3">
        <div class="col">
            <label class="h5">Description</label>
            <InputTextArea class="displaySize" @bind-Value="currentProject!.Description" disabled/>
        </div>
    </div>
    
    <div class="row">
        <div class="col">
            <a href="@currentProject.SourceControlRepository" target="_blank" rel="noopener" aria-label="Visit the project website here">Source Control</a>
        </div>
    </div>

    <div class="row mt-3 pb-3">
        <div class="col">
            <a href="@currentProject.Url" target="_blank" rel="noopener" aria-label="Visit the project website here">Website</a>
        </div>
    </div>
    <div class="row">
        <div class="col">
            <button class="btn btn-primary" @onclick="() => ReturnButton()" >Return to projects</button>
        </div>
    </div>
   
</div>

@code {
     // Add the data model and bind the form data to the page model properties
    [SupplyParameterFromForm]
    private Project? currentProject { get; set; }

    // Get the Id of the record to display from the query string
    [Parameter]
    public int? Id { get; set; }

    protected override void OnInitialized() => currentProject ??= new();

    // Retrieve the data to populate the form for editing
    protected override async Task OnInitializedAsync()
    {
        // Retrieve record information
        currentProject = await httpClient.GetFromJsonAsync<Project>("/project/" + Id.ToString());
    }

    private void ReturnButton() => navigationManager!.NavigateTo("/projects");

}
