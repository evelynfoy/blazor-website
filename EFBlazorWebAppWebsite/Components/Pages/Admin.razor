@page "/admin"
@rendermode InteractiveServer

@inject HttpClient httpClient
@inject NavigationManager navigationManager

<div class="container">
    @* Admin Heading *@
    <div class="row">
        <div class="col mb-3">
            <PageTitle>Admin</PageTitle>
            <h1>Admin</h1>
        </div>
    </div>

    @* My Projects  *@
    <div class="row">
        <div class="col">
            <h2 class="text-primary">My Projects</h2>
            <p>Only I can maintain these projects.</p>
        </div>
    </div>

    @if (projects == null)
    {
        <div class="row">
            <div class="col">
                <p><em>Loading...</em></p>
            </div>
        </div>
    }
    else {
        @* Add Button row *@
        <div class="row">
            <div class="col">
                <button class="btn btn-primary" @onclick="() => AddButton()">Add</button>
            </div>
        </div>
        @* Column Header row *@
        <div class="row fw-bold pt-3">
            <div class="d-none d-sm-block col-sm-4 col-lg-1 ">
                Id
            </div>
            <div class="d-none d-sm-block col-sm-4 col-lg-3">
                Name
            </div>
            <div class="d-none d-sm-block col-sm-4 col-lg-2">
                Type
            </div>
            <div class="d-none d-sm-block col-sm-6 col-lg-6">
                Source Control Repository
            </div>
            <hr>
        </div>
        @foreach (var project in projects)
        {
            @* My Project row *@
            @if (project.Name != null && !project.Name.Contains("Demo"))
            {
                <div class="row ">
                    <div class="col-xs-12 col-sm-1 col-lg-1">
                        @project.Id
                    </div>
                    <div class="col-xs-12 col-sm-7 col-lg-3">
                        @project.Name
                    </div>
                    <div class="col-xs-12 col-sm-4 col-lg-2">
                        @project.Type
                    </div>
                    <div class="col-xs-12 col-sm-8 col-lg-4">
                        <a href="@project.SourceControlRepository" target="_blank" alt="Link to github repos">@project.SourceControlRepository</a>
                    </div>
                    <div class="col-xs-6 col-sm-2 col-lg-1">
                        <button class="btn btn-primary" @onclick="() => EditButton(project.Id)">Edit</button>
                    </div>
                    <hr class="mt-2">
                </div>
            }
        }
    }

    @* Demo Projects *@
    <div class="row mt-3">
        <div class="col">
            <h2 class="text-primary">Play Area</h2>
            <p>Here you can add, edit or delete a demo project to test the functionality. These are not displayed on the projects page.</p>
        </div>
    </div>
    
    @if (projects == null)
    {
        <div class="row">
            <div class="col">
                <p><em>Loading...</em></p>
            </div>
        </div>
    }
    else {
        @* Add Button row *@
        <div class="row">
            <div class="col">
                <button class="btn btn-primary" @onclick="() => AddButton()">Add</button>
            </div>
        </div>
        @* Column Header row *@
        <div class="row fw-bold pt-3">
            <div class="d-none d-sm-block col-sm-4 col-lg-1 ">
                Id
            </div>
            <div class="d-none d-sm-block col-sm-4 col-lg-3">
                Name
            </div>
            <div class="d-none d-sm-block col-sm-4 col-lg-2">
                Type
            </div>
            <div class="d-none d-sm-block col-sm-6 col-lg-6">
                Source Control Repository
            </div>
            <hr>
        </div>
        @foreach (var project in projects)
        {
            @* Demo Project row *@
            @if (project.Name != null && project.Name.Contains("Demo"))
            {
                <div class="row ">
                    <div class="col-xs-12 col-sm-1 col-lg-1">
                        @project.Id
                    </div>
                    <div class="col-xs-12 col-sm-7 col-lg-3">
                        @project.Name
                    </div>
                    <div class="col-xs-12 col-sm-4 col-lg-2">
                        @project.Type
                    </div>
                    <div class="col-xs-12 col-sm-8 col-lg-4">
                        <a href="@project.SourceControlRepository" target="_blank" alt="Link to github repos">@project.SourceControlRepository</a>
                    </div>
                    <div class="col-xs-6 col-sm-4 col-lg-1">
                        <button class="btn btn-primary" @onclick="() => EditButton(project.Id)">Edit</button>
                    </div>
                    <hr class="mt-2">
                </div>
            }
        }
    }
</div>

@code {

    private Project[]? projects;

    protected override async Task OnInitializedAsync()
    {
        projects = await httpClient.GetFromJsonAsync<Project[]?>("/projects");
    }

    private void EditButton(int id) => navigationManager!.NavigateTo($"/edit/{id}");

    private void AddButton() => navigationManager!.NavigateTo("/create");

}
