@page "/projects"
@rendermode InteractiveServer

@inject HttpClient httpClient
@inject NavigationManager navigationManager


<div class="container-fluid">
    <div class="row">
        <div class="col">
            <PageTitle>Projects</PageTitle>
            <h1>Projects</h1>
            <p>This component displays some of my projects using data stored in an API.</p>
        </div>
    </div>
    @if (projects == null)
    {
        <div class="row">
            <div class="col">
                <p><em>Loading...</em></p>
            </div>
        </div>
    }
    else {
        <div class="row fw-bold ">
            <div class="d-none d-sm-block col-sm-4 col-lg-1 ">
                Id
            </div>
            <div class="d-none d-sm-block col-sm-4 col-lg-3">
                Name
            </div>
            <div class="d-none d-sm-block col-sm-4 col-lg-2">
                Type
            </div>
            <div class="d-none d-sm-block col-sm-6 col-lg-6">
                Source Control Repository
            </div>
            <hr>
        </div>
        @foreach (var project in projects)
        {
            <div class="row ">
                <div class="col-xs-12 col-sm-1 col-lg-1">
                    @project.Id
                </div>
                <div class="col-xs-12 col-sm-7 col-lg-3">
                    @project.Name
                </div>
                <div class="col-xs-12 col-sm-4 col-lg-2">
                    @project.Type
                </div>
                <div class="col-xs-12 col-sm-8 col-lg-5">
                    <a href="@project.SourceControlRepository" target="_blank" alt="Link to github repos">@project.SourceControlRepository</a>
                </div>
                <div class="col-xs-12 col-sm-4 col-lg-1">
                    <button class="btn btn-primary" @onclick="() => DetailsButton(project.Id)">Details</button>
                </div>
                <hr class="mt-2">
            </div>
        }
    }
</div>


@code {

private Project[]? projects;

    protected override async Task OnInitializedAsync()
    {
        projects = await httpClient.GetFromJsonAsync<Project[]?>("/projects");
    }

    private void DetailsButton(int id) => navigationManager!.NavigateTo($"/detail/{id}");

}
