@page "/"
@rendermode InteractiveServer
@inject NavigationManager navigationManager

<PageTitle>Evelyn Foy | Software Developer Portfolio</PageTitle>

@* Introduction *@
<section class="py-4 py-md-5 mb-4" id="top">
    <div class="row align-items-center">
        <div class="col-lg-9">
            <p class="text-primary fw-semibold mb-2">
                SOFTWARE DEVELOPMENT PORTFOLIO
            </p>

            <h1 class="display-5 fw-bold mb-3">
                Hi, I'm Evelyn Foy.
            </h1>

            <h2 class="h4 text-body-secondary mb-4">
                Software Developer | C# · .NET · ASP.NET Core
            </h2>

            <p class="lead">
                I’m an experienced IT professional with a background
                in software development, application support and
                enterprise systems.
            </p>

            <p>
                I’m building on my development experience through
                hands-on projects using ASP.NET Core MVC, Web APIs,
                Blazor and other modern development technologies.
                Explore my projects below to see examples of my work.
            </p>

            <div class="d-flex flex-wrap gap-2 mt-4">
                <a href="#projects" class="btn btn-primary">
                    Explore my projects
                </a>

                <a href="https://github.com/evelynfoy"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="btn btn-outline-secondary">
                    GitHub
                </a>

                <a href="https://www.linkedin.com/in/evelynfoy"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="btn btn-outline-secondary">
                    LinkedIn
                </a>
            </div>
        </div>
    </div>
</section>

<hr class="my-5" id="projects" />

@* Featured projects *@

<section class="py-4">
    <div class="mb-4">
        <h2 class="h2 fw-bold">Featured Projects</h2>
        <p class="text-body-secondary">
            Selected projects demonstrating my development skills,
            technical learning and practical application of software
            development concepts.
        </p>
    </div>

    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">

        @* Metal Mate *@
        <div class="col">
            <article class="card h-100 shadow-sm">
                <div class="card-body d-flex flex-column p-4">
                    <span class="badge text-bg-primary align-self-start mb-3">
                        Featured project
                    </span>

                    <h3 class="h4 card-title">Metal Mate</h3>

                    <p class="text-body-secondary small">
                        C# · ASP.NET Core MVC · Entity Framework Core
                        · ASP.NET Core Identity
                    </p>

                    <p class="card-text">
                        A web application that retrieves precious-metal
                        prices from an external API, supports different
                        metals and currencies, and allows authenticated
                        users to manage personalised price-alert requests.
                    </p>

                    <p class="card-text">
                        Features include user authentication, profile
                        preferences, database operations, validation,
                        error handling and automated tests.
                    </p>
                    <p>
                        An azure timer function to process requests and send emails is in progress.
                    </p>
                    <div class="d-flex flex-wrap gap-2">
                        <div class="mt-auto pt-3">
                            <a href="https://github.com/evelynfoy/metal-mate-csharp-project"
                               target="_blank"
                               rel="noopener noreferrer"
                               class="btn btn-outline-primary w-100">
                                View source code
                            </a>
                        </div>
                        <div class="mt-auto pt-3">
                            <a href="https://metalmate-hbdydvh5eagcc8e7.westeurope-01.azurewebsites.net/"
                               target="_blank"
                               rel="noopener noreferrer"
                               class="btn btn-outline-primary w-100">
                                View live application
                            </a>
                        </div>
                    </div>

                </div>
            </article>
        </div>
        @* Blazor website *@
        <div class="col">
            <article class="card h-100 shadow-sm">
                <div class="card-body d-flex flex-column p-4">
                    <div class="d-flex flex-wrap gap-2">
                        <span class="badge text-bg-light border align-self-start mb-3">
                            Blazor
                        </span>
                        <span class="badge text-bg-light border align-self-start mb-3">
                            This website
                        </span>
                    </div>

                    
                    <h3 class="h4 card-title">
                        Blazor Portfolio Website
                    </h3>

                    <p class="text-body-secondary small">
                        C# · Blazor · Minimal API · SQLite
                    </p>

                    <p class="card-text">
                        This portfolio website demonstrates a Blazor
                        application consuming a Minimal API, bringing
                        together front-end components, API communication
                        and database-backed functionality.
                    </p>
                    <p>
                        Features include full CRUD functionality and images stored in Azure blob storage.
                        Both website and api are hosted on Azure.
                    </p>
                    <div class="mt-auto pt-3">
                        <a href="https://github.com/evelynfoy/blazor-website"
                           target="_blank"
                           rel="noopener noreferrer"
                           class="btn btn-outline-primary w-100">
                            View source code - Website
                        </a>
                    </div>
                    <div class="mt-2 pt-3">
                        <a href="https://github.com/evelynfoy/ef-minimal-api"
                           target="_blank"
                           rel="noopener noreferrer"
                           class="btn btn-outline-primary w-100">
                            View source code - API
                        </a>
                    </div>
                </div>
            </article>
        </div>

        @* Django e-commerce project *@
        <div class="col">
            <article class="card h-100 shadow-sm">
                <div class="card-body d-flex flex-column p-4">
                    <span class="badge text-bg-light border align-self-start mb-3">
                        Full-stack development
                    </span>

                    <h3 class="h4 card-title">
                        Cheese and Wine Boutique
                    </h3>

                    <p class="text-body-secondary small">
                        Python · Django · PostgreSQL · JavaScript · Stripe
                    </p>

                    <p class="card-text">
                        A full-stack e-commerce project demonstrating
                        product management, shopping functionality,
                        database integration and payment processing.
                    </p>

                    <div class="col">
                        <img src="images/Cheese.png"
                             class="img-fluid rounded-start project-image"
                             alt="Metal Mate application screenshot" />
                    </div>

                    <div class="mt-auto pt-3">
                        <a href="https://github.com/evelynfoy/the-cheese-and-wine-boutique"
                           target="_blank"
                           rel="noopener noreferrer"
                           class="btn btn-outline-primary w-100">
                            View source code
                        </a>
                    </div>
                </div>
            </article>
        </div>

    </div>

    <div class="text-center mt-4">
        <a href="/Projects" class="btn btn-primary">
            View all projects
        </a>
    </div>
</section>

